# Copy this file to .env and fill in real values. Never commit .env.
# .env is already covered by the repo-root .gitignore.

# URL the agent uses to reach the controller (use the docker-compose
# service name when both run via `docker compose up`).
JENKINS_URL=http://jenkins:8080

# Controller admin account, provisioned by JCasC (core/security.yaml) —
# no more reading initialAdminPassword out of the container.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=changeme
JENKINS_ADMIN_EMAIL=admin@example.invalid

# Name of the agent node, provisioned by JCasC
# (casc/projects/cryptography/agent.yaml).
JENKINS_AGENT_NAME=rust-agent

# Secret token for the agent node. Jenkins computes this per-node internally
# and JCasC cannot pin it — run scripts/fetch-agent-secret.sh once the
# controller is up and healthy to fill this in.
JENKINS_AGENT_SECRET=changeme
